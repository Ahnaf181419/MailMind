# MailMind — top-level environment template
# Copy to .env in the relevant app directory (apps/api/.env or apps/web/.env)
# These are the only env keys the API ever reads.

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# MongoDB
# Leave MONGODB_URI blank to use mongodb-memory-server (recommended for hackathon/demo).
MONGODB_URI=
MONGODB_DB_NAME=mailmind

# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# AI Classification (any OpenAI-compatible endpoint)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# Business Rules
FOLLOWUP_THRESHOLD_HOURS=48
STALE_THRESHOLD_HOURS=48
DIGEST_CACHE_TTL_SECONDS=300
MAX_MESSAGES_PER_THREAD=200

# Sync / Seed
SEED_ON_BOOT=true
DEMO_USER_EMAIL=demo@aust.edu
DEMO_USER_PASSWORD=demo1234

# Gmail OAuth (Phase 2 — unused in MVP; filled here so the UI surfaces a helpful tooltip when missing)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
